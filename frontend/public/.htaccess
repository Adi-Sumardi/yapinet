
# SPA client-side routing (React Router) — semua path yang bukan file/folder
# fisik dilempar ke index.html supaya rute seperti /login atau /ganti-password
# tidak 404 waktu diakses langsung atau di-refresh.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
