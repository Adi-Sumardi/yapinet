
# SPA client-side routing (React Router) — semua path yang bukan file/folder
# fisik dilempar ke index.html supaya rute seperti /login atau /auth/callback
# tidak 404 waktu diakses langsung atau di-refresh.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Clone repo backend ada di public_html/yapinet (document root api.yapinet.id
    # = public_html/yapinet/backend/public). Jangan pernah sajikan isinya (log,
    # composer.lock, file PHP, dll.) lewat yapinet.id — rules/security.md §7.
    RewriteCond %{HTTP_HOST} ^(www\.)?yapinet\.id$ [NC]
    RewriteRule ^yapinet(/|$) - [F,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

# Jangan cache file entry point — kalau ter-cache (browser/CDN), user terus
# dapat build lama. File di assets/ aman di-cache karena namanya ber-hash.
<IfModule mod_headers.c>
    <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
