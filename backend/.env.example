APP_NAME=Yapinet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Override App Registry base_url per aplikasi anak untuk development lokal —
# kosongkan/hapus di produksi supaya AppRegistrySeeder jatuh ke domain asli
# (lihat database/seeders/AppRegistrySeeder.php).
# SNGR_BASE_URL=http://127.0.0.1:8001
# SMYA_BASE_URL=http://127.0.0.1:8002
# SMNK_BASE_URL=http://127.0.0.1:8003
# SMNS_BASE_URL=http://127.0.0.1:8004

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lokal: sqlite. Produksi (Hostinger): mysql — lihat kredensial database di hPanel.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=yapinet
# DB_USERNAME=yapinet_app
# DB_PASSWORD=

# Tanpa Redis di shared hosting — semua lewat tabel MySQL (Bab 05 blueprint).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@yapinet.id"
MAIL_FROM_NAME="${APP_NAME}"

# PWA Yapinet (frontend). Produksi: https://yapinet.id
FRONTEND_URL=http://localhost:5173

# Password awal semua user (login lama via Google diganti email+password —
# lihat migration add_password_to_users_table). Wajib diganti user setelah
# login pertama.
YAPINET_DEFAULT_PASSWORD=Yapinet@2026

VITE_APP_NAME="${APP_NAME}"
