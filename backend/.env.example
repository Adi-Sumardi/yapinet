APP_NAME=Yapinet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Development lokal: URL API ringkasan aplikasi anak dipakai AppRegistrySeeder
# (config/yapinet.php). Di produksi menu diatur admin lewat /admin/menu.
# SNGR_SUMMARY_URL=http://127.0.0.1:8001/api/integrations/yapinet/summary
# SMYA_SUMMARY_URL=http://127.0.0.1:8002/api/integrations/yapinet/summary
# SMNK_SUMMARY_URL=http://127.0.0.1:8003/api/integrations/yapinet/summary
# SMNS_SUMMARY_URL=http://127.0.0.1:8004/api/integrations/yapinet/summary

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
# Produksi: LOG_LEVEL=warning. File log harian disimpan LOG_DAILY_DAYS hari.
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lokal: sqlite. Produksi (Hostinger): mysql — lihat kredensial database di hPanel.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=yapinet
# DB_USERNAME=yapinet_app
# DB_PASSWORD=

# Tanpa Redis di shared hosting — semua lewat tabel MySQL (Bab 05 blueprint).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@yapinet.id"
MAIL_FROM_NAME="${APP_NAME}"

# PWA Yapinet (frontend). Produksi: https://yapinet.id
FRONTEND_URL=http://localhost:5173

# Google Cloud Console > OAuth 2.0 Client ID (Web application).
# Daftarkan DUA Authorized redirect URI:
#   1. GOOGLE_REDIRECT_URI di bawah (login PWA)
#   2. ${APP_URL}/login/google/callback (login sesi untuk SSO aplikasi anak)
# Hanya email yang sudah ditambahkan admin yang bisa masuk.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

VITE_APP_NAME="${APP_NAME}"
